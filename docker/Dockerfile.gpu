# NVIDIA GPU（Quadro T400 など）で認識するコンテナ。
# CUDA 12.8 で動かす。NAS の NVIDIA ドライバが CUDA 12.8 以上に対応していること
# （nvidia-smi の右上の「CUDA Version」で確認できる）。
# onnxruntime-gpu は 1.27 から CUDA 13 用になったので、pyproject.toml で 1.26 までに固定している。
# ---- 検出モデル（COCO で学習済みの YOLO11n）を ONNX に書き出す。ビルドのときだけ使い、最終イメージには ONNX だけを入れる
FROM python:3.12-slim AS model
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir ultralytics onnx onnxslim
WORKDIR /m
RUN yolo export model=yolo11n.pt format=onnx imgsz=320 && test -s /m/yolo11n.onnx

# ---- 本体
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Tokyo

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

WORKDIR /app
COPY pyproject.toml README.md ./
COPY cattoy ./cattoy
RUN pip install ".[nas-gpu]"
# GPU 用のライブラリが、このイメージの CUDA で読み込めるかを確かめる（読めないと黙って CPU で動いてしまうため）
RUN so=$(python -c 'import onnxruntime, os; print(os.path.join(os.path.dirname(onnxruntime.__file__), "capi", "libonnxruntime_providers_cuda.so"))') \
 && test -f "$so" \
 && missing=$(ldd "$so" | grep 'not found' || true) \
 && if [ -n "$missing" ]; then echo "CUDA のライブラリが足りません（onnxruntime-gpu と CUDA の版が合っていない）:"; echo "$missing"; exit 1; fi
COPY --from=model /m/yolo11n.onnx /app/models/yolo11n.onnx
ENV CATTOY_BUNDLED_MODEL=/app/models/yolo11n.onnx

# 設定・キャリブレーション・記録は /data に置く（NAS の共有フォルダをマウントする）。
# 設定ファイルがなくても、環境変数（CATTOY_ESP32_HOST など）と既定値で動く
WORKDIR /data
EXPOSE 8080
ENTRYPOINT ["cattoy", "--config", "/data/config.toml"]
CMD ["run"]
