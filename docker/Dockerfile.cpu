# GPU を使わず CPU だけで認識するコンテナ（GPU がない NAS や、GPU がうまく使えないとき用）。
# ---- 検出モデル（COCO で学習済みの YOLO11n）を ONNX に書き出す。ビルドのときだけ使い、最終イメージには ONNX だけを入れる
FROM python:3.12-slim AS model
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir ultralytics onnx onnxslim
WORKDIR /m
RUN yolo export model=yolo11n.pt format=onnx imgsz=320 && test -s /m/yolo11n.onnx

# ---- 本体
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Tokyo

RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY cattoy ./cattoy
RUN pip install ".[nas]"
COPY --from=model /m/yolo11n.onnx /app/models/yolo11n.onnx
ENV CATTOY_BUNDLED_MODEL=/app/models/yolo11n.onnx

WORKDIR /data
EXPOSE 8080
ENTRYPOINT ["cattoy", "--config", "/data/config.toml"]
CMD ["run"]
