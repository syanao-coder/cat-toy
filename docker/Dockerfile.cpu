# GPU を使わず CPU だけで認識するコンテナ（GPU がない NAS や、GPU がうまく使えないとき用）。
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Tokyo

RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY cattoy ./cattoy
RUN pip install ".[nas]"

WORKDIR /data
EXPOSE 8080
ENTRYPOINT ["cattoy", "--config", "/data/config.toml"]
CMD ["run"]
